# Docker 映射端口（改端口后请同步 DATABASE_URL / REDIS_URL）
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres 容器内账号（一般与 DATABASE_URL 一致）
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=fullstack_rust_react_starter

# Database（host 端口须与 POSTGRES_PORT 一致）
DATABASE_URL=postgres://app:app@localhost:5432/fullstack_rust_react_starter

# Redis（host 端口须与 REDIS_PORT 一致）
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=8080
# 日志级别，如 info,tower_http=debug 或 debug,api=debug
RUST_LOG=info

# Auth (change in production)
JWT_SECRET=dev-change-me-to-a-long-random-string
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=7

# HTTP 中间件
HTTP_BODY_LIMIT_MB=2
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_GLOBAL_PER_MIN=300
RBAC_CACHE_TTL_SECS=60
RBAC_CACHE_MAX_ENTRIES=10000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
